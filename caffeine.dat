#! LAK/def2-TZVP density-fitted geometry optimization and analytic
#! frequencies of caffeine, for the manuscript's larger demonstration.
#! Run as:  psi4 -n <threads> caffeine.dat
#! Starting geometry: PubChem 3D conformer of caffeine (CID 2519).

memory 24 GB

molecule caffeine {
0 1
O    0.470000    2.568800    0.000600
O   -3.127100   -0.443600   -0.000300
N   -0.968600   -1.312500    0.000000
N    2.218200    0.141200   -0.000300
N   -1.347700    1.079700   -0.000100
N    1.411900   -1.937200    0.000200
C    0.857900    0.259200   -0.000800
C    0.389700   -1.026400   -0.000400
C    0.030700    1.422000   -0.000600
C   -1.906100   -0.249500   -0.000400
C    2.503200   -1.199800    0.000300
C   -1.427600   -2.696000    0.000800
C    3.192600    1.206100    0.000300
C   -2.296900    2.188100    0.000700
H    3.516300   -1.578700    0.000800
H   -1.045100   -3.197300   -0.893700
H   -2.518600   -2.759600    0.001100
H   -1.044700   -3.196300    0.895700
H    4.199200    0.780100    0.000200
H    3.046800    1.809200   -0.899200
H    3.046600    1.808300    0.900400
H   -1.808700    3.165100   -0.000300
H   -2.932200    2.102700    0.888100
H   -2.934600    2.102100   -0.884900
symmetry c1
noreorient
}

# LAK (Lebeda, Aschebrock, Kummel) is not in Psi4's registered functional
# list; build it from its Libxc exchange and correlation parts.
lak = {
    "name": "LAK",
    "x_functionals": {"MGGA_X_LAK": {}},
    "c_functionals": {"MGGA_C_LAK": {}},
}

set {
    basis def2-TZVP
    scf_type df
    reference rks
    e_convergence 8
    d_convergence 8
}

import time

t0 = time.time()
e_opt = optimize("SCF", dft_functional=lak)
t1 = time.time()
print_out(f"\nOPT done: E = {e_opt:.8f}  ({t1 - t0:.0f} s)\n")
caffeine.save_xyz_file("caffeine_lak_opt.xyz", True)

e, wfn = frequencies("SCF", dft_functional=lak, dertype=2,
                     return_wfn=True)
t2 = time.time()
print_out(f"\nFREQ done ({t2 - t1:.0f} s)\n")

freqs = wfn.frequencies().to_array()
print_out("Lowest frequencies (cm^-1): "
          + " ".join(f"{f:.2f}" for f in freqs[:8]) + "\n")
print_out("Highest frequencies (cm^-1): "
          + " ".join(f"{f:.2f}" for f in freqs[-4:]) + "\n")
